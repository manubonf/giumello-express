CREATE POLICY "Utenti vedono navette" ON "public"."shuttles" FOR SELECT TO "authenticated" USING ((("status" <> 'cancelled'::"text") OR (EXISTS ( SELECT 1
   FROM "public"."profiles"
  WHERE (("profiles"."id" = "auth"."uid"()) AND ("profiles"."role" = 'master'::"text"))))));



