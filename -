CREATE POLICY "Autenticati leggono proposte" ON "public"."proposals" FOR SELECT TO "authenticated" USING (true);



CREATE POLICY "Partecipanti visibili al booker e al master" ON "public"."booking_participants" FOR SELECT TO "authenticated" USING ((("user_id" = "auth"."uid"()) OR (EXISTS ( SELECT 1
   FROM "public"."bookings"
  WHERE (("bookings"."id" = "booking_participants"."booking_id") AND ("bookings"."booker_id" = "auth"."uid"())))) OR (EXISTS ( SELECT 1
   FROM "public"."profiles"
  WHERE (("profiles"."id" = "auth"."uid"()) AND ("profiles"."role" = 'master'::"text"))))));



